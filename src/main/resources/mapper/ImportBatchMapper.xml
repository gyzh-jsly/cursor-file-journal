<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.filejournal.mapper.ImportBatchMapper">

    <insert id="insert" parameterType="com.filejournal.model.ImportBatch" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO import_batch (batch_name, file_name, import_count, created_at)
        VALUES (#{batchName}, #{fileName}, #{importCount}, #{createdAt})
    </insert>

    <select id="selectById" resultType="com.filejournal.model.ImportBatch">
        SELECT * FROM import_batch WHERE id = #{id}
    </select>

    <select id="selectAll" resultType="com.filejournal.model.ImportBatch">
        SELECT * FROM import_batch ORDER BY created_at DESC
    </select>

    <update id="updateCount">
        UPDATE import_batch SET import_count = #{count} WHERE id = #{id}
    </update>

    <delete id="deleteById">
        DELETE FROM import_batch WHERE id = #{id}
    </delete>
</mapper>